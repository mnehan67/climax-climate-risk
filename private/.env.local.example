# Copy to private/.env.local (never commit / share).
# Optional: lets Claude plan the agent's tool calls. Without it, the offline EN/AR parser answers.
ANTHROPIC_API_KEY=
# Optional model override
CLIMAX_MODEL=claude-sonnet-5-5
# Cesium ion token for the cinematic 3D view (Bing aerial + Cesium OSM Buildings)
CESIUM_ION_TOKEN=
